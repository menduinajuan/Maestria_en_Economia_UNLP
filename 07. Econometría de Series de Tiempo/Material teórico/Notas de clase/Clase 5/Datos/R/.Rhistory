acf(R2)
acf(R2)
View(R2)
R2 <- precio <- ts(R2, frequency = )
acf(R2)
pacf(R2)
acf(R2)
arch.test(R)
fit <- lm(R~)
fit <- lm(R~1)
arch.test(fit)
fit<-arima(RGBP,order=c(0,0,0))
