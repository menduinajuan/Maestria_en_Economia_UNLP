library(forecast)
library(vars)
library(tseries)
library(urca)
library(tsDyn) #Esta paquete, aunque limitado, es lo último que hay en cointegración - Junio 2018#
datos <- read.csv("C:/Users/Magdalena Cornejo/Dropbox/UdeSA/Series de tiempo/2018/Clase 6/R/danish.csv")
attach(datos)
LRM<-ts(LRM, frequency=4, start=c(1974,1))
LRY<-ts(LRY, frequency=4, start=c(1974,1))
IBO<-ts(IBO, frequency=4, start=c(1974,1))
IDE<-ts(IDE, frequency=4, start=c(1974,1))
trim <- seq(as.Date("1974-01-01"), as.Date("1987-10-01"), by="quarter")
#Determino longitud del VAR y estimo:
VARselect(y, lag.max=4, type="both")
var = VAR(y,p=2,type=c("const"))
summary(var)
summary(ca.jo(y, type="trace", ecdet="const", K=1))
summary(ca.jo(y, type="eigen", ecdet="const", K=1))
y = cbind(LRM,LRY,IBO,IDE)
#Determino longitud del VAR y estimo:
VARselect(y, lag.max=4, type="both")
var = VAR(y,p=1,type=c("const"))
summary(var)
summary(ca.jo(y, type="trace", ecdet="const", K=1))
summary(ca.jo(y, type="trace", ecdet="const", K=2))
summary(ca.jo(y, type="eigen", ecdet="const", K=2))
summary(ca.jo(y, type="trace", ecdet="trend", K=2))
summary(ca.jo(y, type="eigen", ecdet="trend", K=2))
#Estimación del VECM (mala noticia: esta función no reporta los errores estándares):
cointest<-ca.jo(y, type="trace", ecdet="const", K=2)
vecm<-cajorls(cointest)
vecm
lm(diff(LRM,1)~lag(LRM,1)+lag(LRY,1)+lag(IBO,1)+lag(IDE,1)+diff(LRM,2)+diff(LRY,2)+diff(IBO,2)+diff(IDE,2) )
library(dyn)
heko(lag)
help(lag)
lm(diff(LRM,1)~lag(LRM,k=1)+lag(LRY,k=1)+lag(IBO,k=1)+lag(IDE,1)+diff(LRM,2)+diff(LRY,2)+diff(IBO,2)+diff(IDE,2) )
LRM1=lag(LRM,1)
LRY1=lag(LRY,1)
LIDE1=lag(IDE,1)
LIBO1=lag(IBO,1)
lm(diff(LRM,1)~LRM1+LRY1+IBO1+IDE1+diff(LRM,2)+diff(LRY,2)+diff(IBO,2)+diff(IDE,2) )
lm(diff(LRM,1)~LRM1+LRY1+LIBO1+LIDE1+diff(LRM,2)+diff(LRY,2)+diff(IBO,2)+diff(IDE,2) )
lm(diff(LRM,1)~LRM1+LRY1+LIBO1+LIDE1)
dLRM=diff(LRM,1)
View(IBO,LIBO1)
View(IBO)
View(LIBO1)
IBO1=lag(IBO,-1)
