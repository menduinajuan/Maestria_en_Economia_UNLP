#Estimando por QML (con errores estándares robustos)
spec=ugarchspec(mean.model=list(armaOrder=c(0,0)),variance.model=list(garchOrder=c(1,1)))
garch11<-ugarchfit(spec,R)
garch11
plot.ts(garch11@fit$var)
