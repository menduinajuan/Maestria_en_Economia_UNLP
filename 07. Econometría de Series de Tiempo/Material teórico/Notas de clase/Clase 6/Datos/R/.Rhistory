datos <- read.csv("C:/Users/Magdalena Cornejo/Dropbox/UdeSA/Series de tiempo/2019/Clase 8/Excel/pfe_mrk.csv")
attach(datos)
PFE<-ts(pfe, frequency=12, start=c(1972,7))
MRK<-ts(mrk, frequency=12, start=c(1972,7))
plot(PFE, main="Monthly returns of Pfizer stock")
plot(MRK, main="Monthly returns of Merck stock")
#Gráfico conjunto
plot(PFE, main="")
lines(MRK, col="red", main="")
#Gráfico conjunto
plot(PFE, main="")
lines(MRK, col="red", main="")
var(PFE)
var(MRK)
cor(PFE,MRK)
PFE2<-ts(PFE^2, frequency=12, start=c(1972,7))
MRK2<-ts(MRK^2, frequency=12, start=c(1972,7))
plot(PFE2, main="Squared monthly returns of Pfizer stock")
plot(MRK2, main="Squared monthly returns of Merck stock")
#Gráfico de conjunto de PFE y PFE2:
par(mfrow=c(2,1),mar= c(2, 2, 2, 0.5),oma=c(0,0,0,0))
plot(PFE,lwd=1, type = "l", xlab="",ylab="",main="Monthly returns of Pfizer stock",bty="n",cex.axis=1.5)
plot(PFE2,lwd=1, type = "l", col="blue", xlab="",ylab="",main="Squared monthly returns of Pfizer stock",bty="n",cex.axis=1.5)
#Gráfico de conjunto de MRK y MRK2:
par(mfrow=c(2,1),mar= c(2, 2, 2, 0.5),oma=c(0,0,0,0))
plot(MRK,lwd=1, type = "l", xlab="",ylab="",main="Monthly returns of Merck stock",bty="n",cex.axis=1.5)
plot(MRK2,lwd=1, type = "l", col="blue", xlab="",ylab="",main="Squared monthly returns of Merck stock",bty="n",cex.axis=1.5)
pfe.mrk=cbind(PFE,MRK)
acf(pfe.mrk^2)   #Correlogramas#
acf(pfe.mrk^2)   #Correlogramas#
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(0,0,0,0),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(1,1,1,1),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(2,1,1,1),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(2,2,1,1),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(2,2,2,1),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
par(mar= c(2,2,4,1),oma=c(0,0,0,0))
acf(pfe.mrk^2)   #Correlogramas#
library(MTS)
bekk11<-BEKK11(pfe.mrk, include.mean = TRUE, cond.dist = "normal") #Va a tardar ¡y mucho!. ¡Paciencia!
View(bekk11$Sigma.t)
var_pfe <- bekk11$Sigma.t[,1]
covar <- bekk11$Sigma.t[,2]
var_mrk <- bekk11$Sigma.t[,4]
par(mfrow=c(3,1),mar= c(2, 2, 2, 0.5),oma=c(0,0,0,0))
plot.ts(var_pfe, main="Varianza condicional estimada de PFE")
plot.ts(var_mrk, main="Varianza condicional estimada de MRK")
plot.ts(covar, main="Covarianza condicional estimada entre PFE y MRK")
#Comparando las varianzas estimadas con los retornos cuadráticos:
plot.ts(var_pfe, main="PFE")
par(new = TRUE)
plot.ts(PFE2, col="red", axes = FALSE, bty = "n", xlab="", ylab="")
axis(side=4, at=pretty(range(PFE)))
#Comparando las varianzas estimadas con los retornos cuadráticos:
plot.ts(var_pfe, main="PFE")
par(new = TRUE)
plot.ts(PFE2, col="red", axes = FALSE, bty = "n", xlab="", ylab="")
axis(side=4, at=pretty(range(PFE)))
#Calculo la correlación condicional estimada:
corr <- covar/(sqrt(var_pfe)*sqrt(var_mrk))
plot.ts(corr, main="Correlación condicional estimada entre PFE y MRK")
library(ccgarch)
?ccgarch
??ccgarch
c.w0=c(1,1)
c:wo
c.w0
c.A0=diag(2)
c.B0=diag(2)
c.R0=diag(2)
CCC<-eccc.estimation(a=c.w0,A=c.A0,B=c.B0,R=c.R0,model="extended",dvar=pfe.mrk)
CCC
plot.ts(CCC$h[,1])
plot.ts(CCC$h[,2])
