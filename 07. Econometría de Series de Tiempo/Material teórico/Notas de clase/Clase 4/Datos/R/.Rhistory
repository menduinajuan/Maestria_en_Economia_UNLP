summary(ur.df(s, type = "trend", selectlags = "BIC"))
ds <- diff(s, differences = 1)*100
plot(ds, main = "Variación del precio spot de la soja en Chicago (en %)")
summary(ur.df(ds, type = "drift", selectlags = "BIC"))
