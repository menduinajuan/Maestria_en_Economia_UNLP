datos <- read.csv("C:/ipc.csv") #("C:/Users/juanc/Desktop/Economía/Maestría en Economía/7. Econometría de Series de Tiempo/Material teórico/Notas de clase/Clase 3/Datos/Excel/ipc.csv")#
