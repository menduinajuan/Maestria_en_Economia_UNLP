install.packages("gets")  #Paquete para implementar IIS, SIS y TIS. También necesita el paquete zoo instalado#
library(zoo)
library(gets)
datos <- read.csv("C:/TCN.csv") #("C:/Users/juanc/Desktop/Economía/Maestría en Economía/7. Econometría de Series de Tiempo/Material teórico/Notas de clase/Clase 3/Datos/Excel/TCN.csv")#
