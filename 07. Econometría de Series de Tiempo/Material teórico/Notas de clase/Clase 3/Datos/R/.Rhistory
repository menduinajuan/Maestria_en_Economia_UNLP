isat(TCN, iis = FALSE, sis = TRUE, tis = FALSE, t.pval = 0.01, plot = TRUE)
isat(TCN, iis = TRUE, sis = TRUE, tis = FALSE, t.pval = 0.005, plot = TRUE)
isat(TCN, iis = TRUE, sis = TRUE, tis = TRUE, t.pval = 0.005, plot = TRUE)
