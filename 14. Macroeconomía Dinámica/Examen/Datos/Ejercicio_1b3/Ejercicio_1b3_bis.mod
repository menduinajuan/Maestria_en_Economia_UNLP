%*************************************************************************%
% 1. VARIABLES Y PARÁMETROS %
%*************************************************************************%


var k y c I N n e w A;
varexo eps;
parameters alpha beta A_bar delta eta tau a b gamma sd_eps;


%*************************************************************************%
% 2. CALIBRACIÓN %
%*************************************************************************%


alpha  = 0.36;
beta   = 0.99;
A_bar  = 1;
delta  = 0.025;
eta    = 0.95;
tau    = 0.62;
a      = 6;
b      = 0.87;
gamma  = 1;
sd_eps = 0.825;


%*************************************************************************%
% 3. MODELO %
%*************************************************************************%


model;

  y      = A*k(-1)^(alpha)*N^(1-alpha);
  y      = c+I;
  N      = n*e;
  I      = k-(1-delta)*k(-1);
  w      = (1-alpha)*y/N;
  w      = a*c*n^(gamma);
  e      = (a*gamma*n^(1+gamma)/(b*(1+gamma)))^(1/tau);
  1/c    = beta*(1/c(+1)*(1-delta+alpha*y(+1)/k));
  log(A) = (1-eta)*log(A_bar)+eta*log(A(-1))+eps;

end;


%*************************************************************************%
% 4. COMPUTACIÓN %
%*************************************************************************%


initval;

  A = 1;
  k = 10;
  y = 1;
  c = 0.8;
  I = 0.2;
  N = 0.25;
  n = 0.5;
  e = 0.5;
  w = 2;

end;

shocks;
  var eps = sd_eps^2;
end;

steady;


%*************************************************************************%
% 5. RESULTADOS %
%*************************************************************************%


stoch_simul(order = 1, hp_filter = 1600, irf = 100) k y c I N n e w A;  